# Church HR Manager Backend Environment Configuration

# Server Port (default: 3001)
PORT=3001

# Environment mode (development / production)
NODE_ENV=development

# JWT Session Authentication Secret (REQUIRED in production)
JWT_SECRET=your_jwt_secret_key_here

# SQLite Database Path (optional override, default: ./church_hr.db)
DB_PATH=./church_hr.db

# Allowed CORS Origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
