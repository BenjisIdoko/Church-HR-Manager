# Church HR Manager Backend Environment Configuration

# Server Port (default: 3001)
PORT=3001

# Environment mode (development / production)
NODE_ENV=development

# JWT Session Authentication Secret (REQUIRED in production - generate with `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_here

# Turso (libSQL) database connection - required. Create with the Turso CLI:
#   turso db create <name>
#   turso db show <name>          -> TURSO_DATABASE_URL
#   turso db tokens create <name> -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Allowed CORS Origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Test database - required to run `npm test` (backend/tests/*.test.js).
# Use a SEPARATE Turso database from the one above so tests never touch
# production data:
#   turso db create church-hr-manager-test
#   turso db show church-hr-manager-test          -> TURSO_TEST_DATABASE_URL
#   turso db tokens create church-hr-manager-test -> TURSO_TEST_AUTH_TOKEN
TURSO_TEST_DATABASE_URL=libsql://your-test-database-name.turso.io
TURSO_TEST_AUTH_TOKEN=your_turso_test_auth_token_here
